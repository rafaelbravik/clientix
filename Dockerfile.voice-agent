# Worker de voz (SIP/ARI + IA em tempo real) — compilado para JavaScript.
# Estágio de build compila o entrypoint eliminando código TypeScript e devDependencies do runtime.

# --- ESTÁGIO 1: CÓDIGO-FONTE COMUM ---
FROM node:22-alpine AS build-base

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile

# Código-fonte para compilação
COPY tsconfig*.json ./
COPY workers ./workers
COPY lib ./lib
COPY app/api ./app/api
COPY scripts ./scripts

FROM build-base AS builder

# Compilar voice-agent de produção com a trust root oficial do repositório.
RUN node scripts/build-worker-bundle.mjs voice-agent && \
    pnpm prune --prod

# O builder de certificação é isolado: somente sua camada substitui trusted-keys.ts.
FROM build-base AS certification-builder

ARG TEST_LICENSE_KEY_ID
ARG TEST_LICENSE_PUBLIC_KEY_BASE64

RUN pnpm exec tsx scripts/build-voice-certification.ts && \
    pnpm prune --prod

# Alvo explicitamente não publicável; contém somente a chave pública TEST.
FROM node:22-alpine AS voice-certification

WORKDIR /app

ARG SOURCE_HEAD=unknown
ARG SOURCE_DIRTY=true
LABEL org.opencontainers.image.source="https://github.com/rafaelbravik/clientix-agencia" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="Clientix Agência voice agent (certificação)" \
      com.clientix.artifact="voice-certification" \
      com.clientix.release-eligible="false" \
      com.clientix.test-trust-root="true" \
      com.clientix.source-head="$SOURCE_HEAD" \
      com.clientix.source-dirty="$SOURCE_DIRTY"

COPY --from=certification-builder --chown=node:node /app/node_modules ./node_modules
COPY --from=certification-builder --chown=node:node /app/package.json ./package.json
COPY --from=certification-builder --chown=node:node /app/dist ./dist

ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION

USER node

CMD ["node", "dist/voice-agent/index.js"]

# --- RUNTIME FINAL HARDENED; runner permanece o alvo padrão de produção ---
FROM node:22-alpine AS runner

WORKDIR /app

LABEL org.opencontainers.image.source="https://github.com/rafaelbravik/clientix-agencia" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="Clientix Agência voice agent"

ARG SOURCE_HEAD=unknown
ARG SOURCE_DIRTY=true
LABEL com.clientix.artifact="voice-production" \
      com.clientix.release-eligible="true" \
      com.clientix.test-trust-root="false" \
      com.clientix.source-head="$SOURCE_HEAD" \
      com.clientix.source-dirty="$SOURCE_DIRTY"

# Dependências estritamente de produção (sem typescript, sem tsx, sem devDeps)
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/package.json ./package.json

# Código compilado (zero arquivos .ts/.tsx proprietários)
COPY --from=builder --chown=node:node /app/dist ./dist

# A versão por ÚLTIMO (invariante de cache).
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION

# Execução como non-root
USER node

CMD ["node", "dist/voice-agent/index.js"]
