# Clientix Agência — contrato de runtime da distribuição comercial.
# Supabase, PostgreSQL, Upstash e WAHA são externos nesta topologia.
# Preencha as conexões e credenciais externas antes de executar install.sh.
# Valores vazios gerados pelo instalador são preenchidos com CSPRNG após o preflight.
# Para GHCR privado, prefira `docker login ghcr.io` com credential helper antes
# da instalação. Alternativamente, REGISTRY_TOKEN e REGISTRY_USERNAME são
# entradas temporárias do processo do instalador; não os grave neste arquivo nem
# em .env. O instalador encerra a sessão GHCR criada com REGISTRY_TOKEN após o pull.

NODE_ENV=production
INSTALLATION_ID=
# Ingress público obrigatório. O modo direto precisa de TCP 80/443 acessíveis;
# DNS-01 não precisa de A/AAAA público nem de entrada nessas portas.
DOMAIN=
ACME_EMAIL=
CLIENTIX_ACME_CHALLENGE=direct
CLIENTIX_ACME_DNS_PROVIDER=
CLIENTIX_ACME_SECRET_MODE=external
CLIENTIX_CLOUDFLARE_TOKEN_FILE=
CLIENTIX_CLOUDFLARE_TOKEN_OWNER_UID=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ADMIN_URL=

# Supabase externo: URL pública, anon key, service role e conexão PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVER_URL=
SUPABASE_DB_URL=
# Opcional: CA pública PEM em base64 para validar PostgreSQL remoto com CA privada.
POSTGRES_SSL_ROOT_CERT=
# Conexão PostgreSQL com permissão de DDL, usada apenas pelo migrator/backup.
SUPABASE_DB_ADMIN_URL=

# Segredos da instalação; gerados automaticamente se estiverem vazios.
INTERNAL_SECRET=
INTERNAL_CRON_SECRET=
CPF_ENCRYPTION_KEY=
WAHA_BYO_ENCRYPTION_KEY=
AI_CRED_AES_KEY=

# Upstash Redis REST externo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WAHA externo; WAHA_WEBHOOK_BASE_URL deve apontar publicamente para este app.
WAHA_API_BASE_URL=
WAHA_API_KEY=
WAHA_WEBHOOK_BASE_URL=
WAHA_HMAC_SECRET=
# Compatível com WAHA Core (sem HMAC). Mude para true somente com WAHA Plus ou
# proxy assinador; nesse modo WAHA_HMAC_SECRET precisa ter >=16 caracteres.
WAHA_WEBHOOK_REQUIRE_SIGNATURE=false

# Recurso parcial: MTProto auth/send dependem de gateway HTTPS; inbound ainda
# não está ligado ao dispatcher. Vazio mantém Telegram User/MTProto desativado.
TELEGRAM_MTPROTO_GATEWAY_URL=

# Credenciais de fallback opcionais; os canais normalmente são configurados por
# sessão no CRM e as credenciais da Meta também podem ser geridas em Admin › API Oficial.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_SYSTEM_USER_TOKEN=
META_WEBHOOK_BASE_URL=
META_GRAPH_VERSION=
META_GRAPH_BASE_URL=
META_ADS_GRAPH_BASE_URL=
ZERNIO_ACCOUNT_ID=
ZERNIO_API_KEY=
ZERNIO_API_BASE_URL=
DATAFY_ENABLED=
DATAFY_API_BASE_URL=

# E-mail transacional opcional; a tela Admin › E-mail também pode armazenar
# credenciais cifradas no banco. SMTP preenchido prevalece sobre Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Voz WhatsApp opcional: `COMPOSE_PROFILES=voz` cria o serviço Wacalls.
# Preencha base, usuário/senha admin e bearer antes de ligar o profile.
COMPOSE_PROFILES=
WACALLS_API_BASE_URL=
WACALLS_API_TOKEN=
WACALLS_ADMIN_USER=
WACALLS_ADMIN_PASSWORD=
WACALLS_CORS_ORIGINS=
WACALLS_TRUSTED_PROXIES=
WACALLS_PUBLIC_IP=
WACALLS_WEBRTC_UDP_PORT=7881

# Telefonia SIP externa opcional. Ative `telefonia` somente após preencher
# ARI_URL, ARI_WS_URL, ARI_USERNAME, ARI_PASSWORD e OPENAI_API_KEY.
ARI_URL=
ARI_WS_URL=
ARI_USERNAME=
ARI_PASSWORD=
ARI_APP=voice-agent
AUDIOSOCKET_PORT=9092
OPENAI_REALTIME_MODEL=
OPENAI_API_KEY=

# Provedor de IA opcional. Também é possível configurar credenciais pela tela.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# O instalador grava aqui somente referências repo@sha256 verificadas.
APP_IMAGE=
WORKER_IMAGE=
SCHEDULER_IMAGE=
VOICE_AGENT_IMAGE=
MIGRATOR_IMAGE=
CADDY_IMAGE=
