# Clientix Agência — Configuração Comercial de Produção
# Gere ou preserve os segredos antes de iniciar os serviços.

# Identificador único de instalação (gerado no first install, NUNCA altere)
INSTALLATION_ID=

# Versão do Clientix fixada para este deployment
CLIENTIX_VERSION=1.0.0

# Domínio público da instalação (ex: crm.suaempresa.com.br)
APP_DOMAIN=localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Conexão com o Banco de Dados PostgreSQL (gerenciado ou local)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@postgres:5432/postgres

# Segredos da Aplicação (gerados com CSPRNG no install)
NEXTAUTH_SECRET=
ENCRYPTION_KEY=
INTERNAL_API_SECRET=
INTERNAL_CRON_SECRET=
IMPERSONATE_COOKIE_SECRET=

# Redis / Upstash (filas, cache e locks)
REDIS_URL=redis://redis:6379

# WAHA (WhatsApp HTTP API)
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=

# Imagens de Produção (ou substituições locais em teste)
APP_IMAGE=ghcr.io/rafaelbravik/clientix-app:1.0.0
WORKER_IMAGE=ghcr.io/rafaelbravik/clientix-worker:1.0.0
SCHEDULER_IMAGE=ghcr.io/rafaelbravik/clientix-scheduler:1.0.0
VOICE_AGENT_IMAGE=ghcr.io/rafaelbravik/clientix-voice-agent:1.0.0
MIGRATOR_IMAGE=ghcr.io/rafaelbravik/clientix-migrator:1.0.0
